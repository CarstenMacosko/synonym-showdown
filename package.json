{
  "name": "synonym-showdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "words:download": "node tools/wordbank/download.ts",
    "words:candidates": "node tools/wordbank/candidates.ts",
    "words:review": "node --env-file-if-exists=tools/wordbank/.env tools/wordbank/review.ts",
    "words:grade": "node --max-old-space-size=6144 tools/wordbank/grade.ts",
    "words:build": "node tools/wordbank/build.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
